<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">

    <display-name>SitArequipaMVC</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Cadena de filtros de seguridad (el orden de declaración = orden de ejecución):
         1) Cabeceras (CSP, X-Frame-Options, nosniff...)  2) Token anti-CSRF  3) Autenticación JWT + roles -->
    <filter>
        <filter-name>CabecerasSeguridadFilter</filter-name>
        <filter-class>filtro.CabecerasSeguridadFilter</filter-class>
    </filter>
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>filtro.CsrfFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AutenticacionFilter</filter-name>
        <filter-class>filtro.AutenticacionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CabecerasSeguridadFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/app/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutenticacionFilter</filter-name>
        <url-pattern>/app/*</url-pattern>
    </filter-mapping>

    <!-- HTTPS obligatorio: Tomcat redirige HTTP -> HTTPS (connector redirectPort) -->
    <!-- HTTPS obligatorio temporalmente deshabilitado para pruebas locales -->
    <!--
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Toda la aplicación</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    -->

    <!-- No usamos HttpSession: la autenticación es stateless con JWT -->
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Errores genéricos: nunca se muestra el stack trace -->
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
</web-app>
